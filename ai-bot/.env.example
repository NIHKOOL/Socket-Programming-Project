# คัดลอกไฟล์นี้เป็น ai-bot/.env แล้วใส่ค่าจริง (ai-bot/.env ถูก .gitignore ไว้ ห้าม commit)

# ---- ต่อเข้า chat server ----
# server ที่จะต่อ (ไม่ใส่ = http://localhost:3000)
SERVER_URL=
# รหัสลับของ bot: ต้องตรงกับ AI_BOT_TOKEN ใน server/.env (ไม่งั้น server ไม่ให้ใช้ชื่อ "AI")
# ตั้งเป็นข้อความสุ่มยาว ๆ อะไรก็ได้ เช่น ผลของ: node -e "console.log(crypto.randomUUID())"
AI_BOT_TOKEN=

# ---- AI ที่ใช้ในเกมทายคำ (ดู docs/features/guess_TEST.md) ----
# ใส่ key อย่างน้อย 1 เจ้า (ห้ามแชร์ / ห้าม commit)
# Claude:  https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# ChatGPT: https://platform.openai.com → API keys   (OPENAI_MODEL ไม่ใส่ = gpt-5.5)
OPENAI_API_KEY=
OPENAI_MODEL=
# Gemini:  https://aistudio.google.com → Get API key (GEMINI_MODEL ไม่ใส่ = gemini-flash-latest)
GEMINI_API_KEY=
GEMINI_MODEL=
# AI ที่ใช้เมื่อไม่ได้ระบุตอน /guess start (claude | chatgpt | gemini) ไม่ใส่ = ตัวแรกที่มี key
GUESS_AI_PROVIDER=
# ทายผิด → AI ใบ้: คนเดิมได้ 1 ครั้งต่อกี่ ms (ไม่ใส่ = 5000) / สูงสุดกี่ครั้งต่อเกม (ไม่ใส่ = 40)
GUESS_FEEDBACK_COOLDOWN_MS=
GUESS_MAX_FEEDBACK=
