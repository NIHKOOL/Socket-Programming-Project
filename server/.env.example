# คัดลอกไฟล์นี้เป็น server/.env แล้วใส่ค่าจริง (server/.env ถูก .gitignore ไว้ ห้าม commit)
# บน Render: ใส่ค่าเดียวกันใน Dashboard → Environment

# ---- Feature: discord (ดู docs/features/discord_TEST.md) ----
# token ของ bot จาก Discord Developer Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=
# id ของ channel ที่จะ bridge (Discord: Settings → Advanced → Developer Mode แล้วคลิกขวาที่ channel → Copy Channel ID)
DISCORD_CHANNEL_ID=
# ชื่อกลุ่มในแอปที่ bridge กับ channel นี้ (ไม่ใส่ = discord)
DISCORD_GROUP=discord
